# The groups of the imports at the top of the Swift files in `paths`, which `make format` groups and `make lint` checks
# with `scripts/imports/group-imports.sh`.
#
# The imports go in the groups in this order, with a blank line between groups. `*` is the group of the modules that no
# group lists, the system frameworks.

paths: packages/ChouTi packages/ChouTiTest playgrounds scripts/imports

# system frameworks
group: *

# test frameworks
group: ChouTiTest XCTest

# local modules
group: ChouTi
